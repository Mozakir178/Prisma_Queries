
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  fullName  String
  bio       String?
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  caption   String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


